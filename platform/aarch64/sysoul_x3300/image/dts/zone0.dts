	spi@feb30000 {
		compatible = "rockchip,rk3066-spi";
		reg = <0x00 0xfeb30000 0x00 0x1000>;
		interrupts = <0x00 0x149 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <&cru 0xa6 &cru 0xa1>;
		clock-names = "spiclk", "apb_pclk";
		dmas = <0xf4 0x11 0xf4 0x12>;
		dma-names = "tx", "rx";
		pinctrl-names = "default";
		pinctrl-0 = <0x173 0x174 0x175>;
		num-cs = <0x02>;
		status = "disabled";
		phandle = <0x2f5>;
	};

	serial@feb40000 {
		compatible = "rockchip,rk3588-uart", "snps,dw-apb-uart";
		reg = <0x00 0xfeb40000 0x00 0x100>;
		interrupts = <0x00 0x14c 0x04>;
		clocks = <&cru 0xb7 &cru 0xab>;
		clock-names = "baudclk", "apb_pclk";
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		dmas = <0x7a 0x08 0x7a 0x09>;
		pinctrl-names = "default";
		pinctrl-0 = <0x176>;
		status = "disabled";
		phandle = <0x2f6>;
