					clocks = <&cru 0x1ba &cru 0x1b9>;
					pm_qos = <0x9a>;
				};
			};

			power-domain@24 {
				reg = <0x18>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clocks = <&cru 0x26e &cru 0x26d &cru 0x270>;
				pm_qos = <0x9b 0x9c>;

				power-domain@25 {
					reg = <0x19>;
