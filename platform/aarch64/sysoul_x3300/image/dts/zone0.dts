					pm_qos = <0x9d>;
				};
			};

			power-domain@26 {
				reg = <0x1a>;
				clocks = <&cru 0x22e &cru 0x22f &cru 0x22d &cru 0x218 &cru 0x217 &cru 0x22b &cru 0x264>;
