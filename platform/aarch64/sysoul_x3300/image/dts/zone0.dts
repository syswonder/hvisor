	pcie@fe180000 {
		compatible = "rockchip,rk3588-pcie", "snps,dw-pcie";
		#address-cells = <0x03>;
		#size-cells = <0x02>;
		bus-range = <0x30 0x3f>;
		clocks = <&cru 0x151 &cru 0x156 &cru 0x14c &cru 0x15c &cru 0x161 &cru 0x2c5>;
		clock-names = "aclk_mst", "aclk_slv", "aclk_dbi", "pclk", "aux", "pipe";
		device_type = "pci";
		interrupts = <0x00 0xf8 0x04 0x00 0xf7 0x04 0x00 0xf6 0x04 0x00 0xf5 0x04 0x00 0xf4 0x04>;
		interrupt-names = "sys", "pmc", "msg", "legacy", "err";
		#interrupt-cells = <0x01>;
		interrupt-map-mask = <0x00 0x00 0x00 0x07>;
		interrupt-map = <0x00 0x00 0x00 0x01 0x111 0x00 0x00 0x00 0x00 0x02 0x111 0x01 0x00 0x00 0x00 0x03 0x111 0x02 0x00 0x00 0x00 0x04 0x111 0x03>;
		linux,pci-domain = <0x03>;
		num-ib-windows = <0x08>;
		num-ob-windows = <0x08>;
		num-viewport = <0x04>;
		max-link-speed = <0x02>;
		msi-map = <0x3000 0x112 0x3000 0x1000>;
		num-lanes = <0x01>;
		phys = <0x71 &cru>;
		phy-names = "pcie-phy";
		ranges = <0x81000000 0x00 0xf3100000 0x00 0xf3100000 0x00 0x100000 0x82000000 0x00 0xf3200000 0x00 0xf3200000 0x00 0xe00000 0xc3000000 0x09 0xc0000000 0x09 0xc0000000 0x00 0x40000000>;
		reg = <0x00 0xfe180000 0x00 0x10000 0x0a 0x40c00000 0x00 0x400000 0x00 0xf3000000 0x00 0x100000>;
		reg-names = "pcie-apb", "pcie-dbi", "config";
		resets = <&cru 0x210 &cru 0x21f>;
		reset-names = "pcie", "periph";
		rockchip,pipe-grf = <0x77>;
		status = "disabled";
		phandle = <0x2b5>;

		legacy-interrupt-controller {
			interrupt-controller;
			#address-cells = <0x00>;
			#interrupt-cells = <0x01>;
			interrupt-parent = <&gic>;
			interrupts = <0x00 0xf5 0x01>;
			phandle = <0x111>;
		};
	};

