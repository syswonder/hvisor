				};

				power-domain@14 {
					reg = <0x0e>;
					clocks = <&cru 0x18f &cru 0x1be &cru 0x1bc &cru 0x190>;
					pm_qos = <0x89>;
				};

				power-domain@15 {
					reg = <0x0f>;
					clocks = <&cru 0x194 &cru 0x1be &cru 0x1bc>;
					pm_qos = <0x8a>;
				};

				power-domain@22 {
