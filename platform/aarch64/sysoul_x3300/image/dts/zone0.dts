						clocks = <&cru 0x12f &cru 0x131 &cru 0x130>;
						pm_qos = <0x83>;
					};

					power-domain@11 {
						reg = <0x0b>;
						clocks = <&cru 0x12f &cru 0x131 &cru 0x130>;
						pm_qos = <0x84>;
					};
				};
			};

			power-domain@12 {
				reg = <0x0c>;
				clocks = <&cru 0x114 &cru 0x115 &cru 0x116>;
				pm_qos = <0x85 0x86 0x87 0x88>;
			};

			power-domain@13 {
				reg = <0x0d>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				power-domain@14 {
					reg = <0x0e>;
					clocks = <&cru 0x18f &cru 0x1be &cru 0x1bc &cru 0x190 &cru 0x18e>;
					pm_qos = <0x89>;
				};

				power-domain@15 {
