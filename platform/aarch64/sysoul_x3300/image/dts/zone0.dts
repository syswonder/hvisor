		uart_rts_gpios = <0x10a 0x14 0x01>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0x203 0x204 0x205 0x206>;
		pinctrl-1 = <0x207>;
		BT,reset_gpio = <0xfa 0x16 0x00>;
		BT,wake_gpio = <0xfa 0x15 0x00>;
		BT,wake_host_irq = <0xfa 0x00 0x00>;
		status = "okay";
