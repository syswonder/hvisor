Subject: [PATCH] virtio: bound descriptor walk and validate buffers against zone RAM

Target  : hvisor-tool/tools/virtio/virtio.c
Baseline: hvisor-tool @ 31ef380
Apply   : from the hvisor-tool source root:  git apply harden_virtio_backend.patch
          (or: patch -p1 < harden_virtio_backend.patch)

The zone0 VirtIO backend trusts guest-supplied virtqueue fields. The zone-mem
refactor at this baseline makes get_virt_addr() fail closed (return NULL) on an
out-of-zone IPA, but its callers still pass unchecked buffers to device
emulation and the descriptor walk itself is unbounded:
  * process_descriptor_chain() indexes vq->desc_table[next] with a fully
    guest-controlled "next" and no bounds check, follows vdesc->next with no
    cycle guard, trusts an attacker-controlled indirect-table length to size a
    malloc (no NULL check), and walks the indirect table via an unbounded
    for(;;) loop, validating only the table base (not its full extent).
  * descriptor2iov() hands [addr, addr+len) to the device emulation with no
    check that the buffer lies inside the zone, and ignores get_virt_addr()'s
    NULL return.

This patch: bounds-checks every descriptor index against vq->num in both walk
loops; caps the chain at MAX_DESC_CHAIN_DEPTH (defeats circular chains); bounds
the indirect-table size and validates its full extent with virtio_buffer_in_zone();
refuses rings/tables whose IPA failed to map; checks every malloc; adds
virtio_buffer_in_zone() and enforces it (plus the descriptor2iov return) in the
walk; and drops a malformed chain whole (frees the partially-filled iov/flags
and returns 0) so the caller never consumes uninitialised entries. Maps to fuzz
cases D2.1-D2.5 and attacks A6/A7.

diff --git a/tools/virtio/virtio.c b/tools/virtio/virtio.c
index c2d56d8..3574ed4 100644
--- a/tools/virtio/virtio.c
+++ b/tools/virtio/virtio.c
@@ -385,6 +385,31 @@ void *get_virt_addr(void *zonex_ipa, int zone_id) {
     return NULL;
 }
 
+// Upper bound on the number of descriptors the backend walks for one request.
+// It caps iov allocation sizing and guarantees termination on circular chains.
+// Emulated queues are <= VIRTQUEUE_BLK_MAX_SIZE, so it never rejects a
+// legitimate chain.
+#define MAX_DESC_CHAIN_DEPTH 1024
+
+// Return true iff [zonex_ipa, zonex_ipa+len) lies fully inside a single declared
+// RAM region of zone_id. Used to reject descriptor buffers whose guest-supplied
+// address/length escape the zone before they reach the device emulation.
+bool virtio_buffer_in_zone(uint64_t zonex_ipa, uint64_t len, int zone_id) {
+    struct zone_mem *z = &zone_mem[zone_id];
+    uint64_t end;
+    if (len == 0)
+        return true;
+    if (__builtin_add_overflow(zonex_ipa, len, &end))
+        return false;
+    for (size_t i = 0; i < z->num_regions; i++) {
+        uint64_t base = z->regions[i].zonex_ipa;
+        uint64_t size = z->regions[i].mem_size;
+        if (zonex_ipa >= base && end <= base + size)
+            return true;
+    }
+    return false;
+}
+
 // When virtio device is processing virtqueue, driver adding an elem to
 // virtqueue is no need to notify device.
 void virtqueue_disable_notify(VirtQueue *vq) {
@@ -434,15 +459,27 @@ inline int descriptor2iov(int i, volatile VirtqDesc *vd, struct iovec *iov,
                           uint16_t *flags, int zone_id, bool copy_flags) {
     void *host_addr;
 
+    // Reject descriptor buffers whose guest-supplied [addr, addr+len) escapes
+    // the owning zone's RAM before exposing a host pointer/length to the device
+    // emulation.
+    if (!virtio_buffer_in_zone(vd->addr, vd->len, zone_id)) {
+        log_error("descriptor2iov: zone %d descriptor buffer addr %#llx len %#x "
+                  "outside zone RAM; dropping",
+                  zone_id, (unsigned long long)vd->addr, vd->len);
+        iov[i].iov_base = NULL;
+        iov[i].iov_len = 0;
+        if (copy_flags)
+            flags[i] = vd->flags;
+        return -1;
+    }
+
     host_addr = get_virt_addr((void *)vd->addr, zone_id);
     iov[i].iov_base = host_addr;
-    iov[i].iov_len = vd->len;
-    // log_debug("vd->addr ipa is %x, iov_base is %x, iov_len is %d", vd->addr,
-    // host_addr, vd->len);
+    iov[i].iov_len = host_addr ? vd->len : 0;
     if (copy_flags)
         flags[i] = vd->flags;
 
-    return 0;
+    return host_addr ? 0 : -1;
 }
 
 /// record one descriptor list to iov
@@ -457,10 +494,27 @@ int process_descriptor_chain(VirtQueue *vq, uint16_t *desc_idx,
     uint16_t next, last_avail_idx;
     volatile VirtqDesc *vdesc, *ind_table, *ind_desc;
     int chain_len = 0, i, table_len;
+    // Counts descriptors actually walked, so the walk terminates even if the
+    // guest builds a self-referential chain.
+    unsigned int steps = 0;
+
+    // Leave the outputs NULL so every early/abort return below is safe for the
+    // caller to free without touching an uninitialised pointer.
+    *iov = NULL;
+    if (copy_flags)
+        *flags = NULL;
 
     // idx is the last available index processed during the last kick
     last_avail_idx = vq->last_avail_idx;
 
+    // Refuse rings that failed to map (get_virt_addr returned NULL).
+    if (vq->desc_table == NULL || vq->avail_ring == NULL) {
+        log_error("process_descriptor_chain: zone %d has unmapped desc/avail "
+                  "ring; dropping request",
+                  vq->dev->zone_id);
+        return 0;
+    }
+
     // No new requests
     if (last_avail_idx == vq->avail_ring->idx)
         return 0;
@@ -472,18 +526,40 @@ int process_descriptor_chain(VirtQueue *vq, uint16_t *desc_idx,
     *desc_idx = next = vq->avail_ring->ring[last_avail_idx & (vq->num - 1)];
     // Record the length of the descriptor chain to chain_len
     for (i = 0; i < (int)vq->num; i++, next = vdesc->next) {
+        // The descriptor index comes straight from the guest (avail ring /
+        // vdesc->next). Reject indices outside the descriptor table instead of
+        // reading out of bounds, and abort chains longer than
+        // MAX_DESC_CHAIN_DEPTH (e.g. circular chains).
+        if (next >= vq->num) {
+            log_error("process_descriptor_chain: zone %d desc index %u >= queue "
+                      "size %u; aborting chain",
+                      vq->dev->zone_id, next, vq->num);
+            return 0;
+        }
+        if (++steps > MAX_DESC_CHAIN_DEPTH) {
+            log_error("process_descriptor_chain: zone %d chain exceeds %d "
+                      "descriptors (possible circular chain); aborting",
+                      vq->dev->zone_id, MAX_DESC_CHAIN_DEPTH);
+            return 0;
+        }
         // Get a descriptor
         vdesc = &vq->desc_table[next];
-        // TODO: vdesc->len may not be chain_len, virtio specification doesn't
-        // say it.
 
         // Check if this descriptor supports the VRING_DESC_F_INDIRECT feature
         // If supported, it means that the descriptor points to a set of
         // descriptors, i.e., one descriptor can describe multiple scattered
         // buffers
         if (vdesc->flags & VRING_DESC_F_INDIRECT) {
-            chain_len +=
-                vdesc->len / 16; // This descriptor points to 16 descriptors
+            // Bound the attacker-controlled indirect table size so the iov
+            // allocation cannot be inflated.
+            uint32_t entries = vdesc->len / 16;
+            if (entries == 0 || entries > MAX_DESC_CHAIN_DEPTH) {
+                log_error("process_descriptor_chain: zone %d indirect table len "
+                          "%#x out of range; aborting chain",
+                          vq->dev->zone_id, vdesc->len);
+                return 0;
+            }
+            chain_len += (int)entries; // points to `entries` descriptors
             i--;
         }
         // Exit if there is no next descriptor
@@ -494,30 +570,86 @@ int process_descriptor_chain(VirtQueue *vq, uint16_t *desc_idx,
     // Update chain length and reset next to the first descriptor
     chain_len += i + 1, next = *desc_idx;
 
+    // Final sanity bound before allocating.
+    if (chain_len <= 0 || chain_len > MAX_DESC_CHAIN_DEPTH) {
+        log_error("process_descriptor_chain: zone %d computed chain_len %d out "
+                  "of range; aborting",
+                  vq->dev->zone_id, chain_len);
+        return 0;
+    }
+
     // Allocate a buffer for each descriptor, using iov to manage them uniformly
     *iov = malloc(sizeof(struct iovec) * (chain_len + append_len));
-    if (copy_flags)
+    if (*iov == NULL) {
+        log_error("process_descriptor_chain: iov allocation failed");
+        return 0;
+    }
+    if (copy_flags) {
         // Record the flag of each descriptor
         *flags = malloc(sizeof(uint16_t) * (chain_len + append_len));
+        if (*flags == NULL) {
+            log_error("process_descriptor_chain: flags allocation failed");
+            free(*iov);
+            *iov = NULL;
+            return 0;
+        }
+    }
 
     // Traverse the descriptor chain and copy the buffer pointed to by each
-    // descriptor to iov
+    // descriptor to iov. A malformed chain is dropped whole: on any abort the
+    // partially-filled iov/flags are freed and 0 is returned, so the caller
+    // never consumes uninitialised entries (or a count larger than was filled).
     for (i = 0; i < chain_len; i++, next = vdesc->next) {
+        // Same out-of-bounds guard as the sizing loop above.
+        if (next >= vq->num) {
+            log_error("process_descriptor_chain: zone %d desc index %u >= queue "
+                      "size %u during copy; aborting",
+                      vq->dev->zone_id, next, vq->num);
+            goto bad_chain;
+        }
         vdesc = &vq->desc_table[next];
         // If the descriptor supports the VRING_DESC_F_INDIRECT feature
         if (vdesc->flags & VRING_DESC_F_INDIRECT) {
-            // Get the address of the indirect table pointed to by this
-            // descriptor
+            uint32_t ind_entries = vdesc->len / 16;
+            if (ind_entries == 0 || ind_entries > MAX_DESC_CHAIN_DEPTH) {
+                log_error("process_descriptor_chain: zone %d indirect table len "
+                          "%#x out of range; aborting",
+                          vq->dev->zone_id, vdesc->len);
+                goto bad_chain;
+            }
+            // Validate the whole indirect-table extent (ind_entries * 16 bytes),
+            // not just its base address, before dereferencing any entry.
+            if (!virtio_buffer_in_zone(vdesc->addr, (uint64_t)ind_entries * 16,
+                                       vq->dev->zone_id)) {
+                log_error("process_descriptor_chain: zone %d indirect table "
+                          "[%#llx,+%#x) outside zone; aborting",
+                          vq->dev->zone_id, (unsigned long long)vdesc->addr,
+                          ind_entries * 16);
+                goto bad_chain;
+            }
             ind_table = (VirtqDesc *)(get_virt_addr((void *)vdesc->addr,
                                                     vq->dev->zone_id));
-            table_len = vdesc->len / 16;
+            if (ind_table == NULL)
+                goto bad_chain;
+            table_len = (int)ind_entries;
             log_debug("find indirect desc, table_len is %d", table_len);
             next = 0;
             for (;;) {
-                // log_debug("indirect desc next is %d", next);
+                // Bound the indirect walk by the remaining iov capacity, the
+                // table length, and the table index.
+                if (i >= chain_len || table_len <= 0)
+                    break;
+                if (next >= ind_entries) {
+                    log_error("process_descriptor_chain: zone %d indirect index "
+                              "%u >= table entries %u; aborting",
+                              vq->dev->zone_id, next, ind_entries);
+                    goto bad_chain;
+                }
                 ind_desc = &ind_table[next];
-                descriptor2iov(i, ind_desc, *iov, flags == NULL ? NULL : *flags,
-                               vq->dev->zone_id, copy_flags);
+                if (descriptor2iov(i, ind_desc, *iov,
+                                   flags == NULL ? NULL : *flags,
+                                   vq->dev->zone_id, copy_flags) != 0)
+                    goto bad_chain;
                 table_len--;
                 i++;
                 // No more next descriptor
@@ -527,15 +659,25 @@ int process_descriptor_chain(VirtQueue *vq, uint16_t *desc_idx,
             }
             if (table_len != 0) {
                 log_error("invalid indirect descriptor chain");
-                break;
+                goto bad_chain;
             }
         } else {
             // For a normal descriptor, copy it directly to iov
-            descriptor2iov(i, vdesc, *iov, flags == NULL ? NULL : *flags,
-                           vq->dev->zone_id, copy_flags);
+            if (descriptor2iov(i, vdesc, *iov, flags == NULL ? NULL : *flags,
+                               vq->dev->zone_id, copy_flags) != 0)
+                goto bad_chain;
         }
     }
     return chain_len;
+
+bad_chain:
+    free(*iov);
+    *iov = NULL;
+    if (copy_flags) {
+        free(*flags);
+        *flags = NULL;
+    }
+    return 0;
 }
 
 void update_used_ring(VirtQueue *vq, uint16_t idx, uint32_t iolen) {
