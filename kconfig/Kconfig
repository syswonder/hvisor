mainmenu "hvisor platform options"

menu "Target architecture"
choice
	prompt "CPU architecture"
	default ARCH_AARCH64

config ARCH_AARCH64
	bool "aarch64 (ARM64)"

config ARCH_RISCV64
	bool "riscv64 (RV64)"

config ARCH_LOONGARCH64
	bool "loongarch64"

config ARCH_X86_64
	bool "x86_64"

endchoice
endmenu

menu "General"
config IOMMU
	bool "IOMMU support"
	default n
config SHARE_S2PT
	bool "Share stage-2 page tables with IOMMU"
	select IOMMU
	default n
config PRINT_TIMESTAMP
	bool "Print timestamp in logs"
	default n
endmenu

menu "PCIe"
config PCI
	bool "PCI/PCIe support"
	default n

choice
	prompt "PCIe Architecture"
	depends on PCI
	default PCIE_ECAM

config PCIE_ECAM
	bool "ECAM PCIe"

config PCIE_DWC
	bool "DesignWare Core PCIe"

config PCIE_LOONGARCH64
	bool "LoongArch PCIe"
	depends on ARCH_LOONGARCH64

endchoice

config NO_PCIE_BAR_REALLOC
	bool "Do not reallocate PCIe BARs (board-specific)"
	depends on PCI
	default n
endmenu

menu "IOMMU hardware"
config ARM_SMMU
	bool "ARM SMMU"
	depends on ARCH_AARCH64
	select IOMMU
	default n
config INTEL_VTD
	bool "Intel VT-d"
	depends on ARCH_X86_64
	select IOMMU
	default n
config RISCV_IOMMU
	bool "RISC-V IOMMU"
	depends on ARCH_RISCV64
	select IOMMU
	default n
endmenu

menu "ARM (AArch64) interrupt controller (GIC)"
	depends on ARCH_AARCH64

config IRQ_GICV2
	bool "GICv2"
	default n
config IRQ_GICV3
	bool "GICv3"
	default n
endmenu

menu "RISC-V interrupt controller / timer"
	depends on ARCH_RISCV64

config PLIC
	bool "PLIC"
	default n
config DP1000_PLIC
	bool "DP1000 PLIC variant"
	depends on PLIC
	default n
config AIA
	bool "AIA (APLIC/IMSIC)"
	default n
config ACLINT
	bool "ACLINT (MTI/MSI)"
	default n
config SSTC
	bool "Sstc extension"
	default n
config EIC770X_SOC
	bool "EIC770x SoC integration"
	default n
config EIC7700_SYSREG
	bool "EIC7700 system registers"
	depends on EIC770X_SOC
	default n
config SIFIVE_CCACHE
	bool "SiFive ccache (EIC770x)"
	depends on EIC770X_SOC
	default n
endmenu

menu "LoongArch"
	depends on ARCH_LOONGARCH64

config LOONGSON_7A2000
	bool "Loongson 7A2000 interrupt controller"
	default n
config LOONGSON_3A5000
	bool "Loongson 3A5000 CPU profile"
	default n
config LOONGSON_3A6000
	bool "Loongson 3A6000 CPU profile"
	default n
endmenu

menu "UART"
config PL011
	bool "ARM PL011 UART"
	default n
config IMX_UART
	bool "NXP i.MX UART"
	default n
config XUARTPS
	bool "Xilinx XUARTPS"
	default n
config UART_16550
	bool "16550-compatible (generic)"
	default n
config UART16550A
	bool "16550A (x86)"
	default n
config LOONGSON_UART
	bool "Loongson UART"
	default n
endmenu

menu "x86 display"
	depends on ARCH_X86_64

config GRAPHICS
	bool "Framebuffer / graphics"
	default n
config SPLIT_SCREEN
	bool "Split screen layout"
	depends on GRAPHICS
	default n
endmenu

menu "Debug"
config EXTIOI_DEBUG
	bool "EXTIOI debug (LoongArch LS7A2000)"
	depends on ARCH_LOONGARCH64
	default n
endmenu
